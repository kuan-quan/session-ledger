{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",

  // Auto-load the snapshot and the stable architecture notes on every session.
  // Keep both files short: they are paid for on every request.
  "instructions": ["docs/STATE.md", "docs/ARCHITECTURE.md"],

  // Keep more recent history when a long session is compacted.
  "compaction": {
    "auto": true,
    "keep": { "tokens": 30000 },
    "buffer": "20%"
  },

  // OpenCode-only bonus: footer indicator + low-context warnings.
  "plugins": ["./.opencode/plugins/token-warning"]
}
